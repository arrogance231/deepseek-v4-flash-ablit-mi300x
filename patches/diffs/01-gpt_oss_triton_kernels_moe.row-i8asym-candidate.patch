+            )
+        schedule16 = _cj_schedule[0, :min(total, 256) + total // 16]
+        schedule48 = _cj_schedule[1, :min(total, 256) + total // 48]
+        schedule64 = _cj_schedule[2, :min(total, 256) + total // 64]
